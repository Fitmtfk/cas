{
    "version": "0.1.0.138",
    "description": "一个GUI setup选项修改器。GUI setup options modifier",
    "homepage": "https://github.com/MikeWuPing/gsetupmod",
    "license": "MIT",
    "url": "https://github.com/MikeWuPing/gsetupmod/releases/download/v0.1.0.138/gsetupmod-boot-0.1.0.138.iso#dl.iso_",
    "hash": "699936b495e7bd788b38eeed3bf1d5d00087e6054b29717ecf8816a057f0e7d3",
    "installer": {
        "script": "Rename-Item $dir\\*.iso_ $dir\\gsetupmod-boot-$version.iso"
    },
    "post_install": [
        "Invoke-CachedDownload $app ${version}\"_manual-brief\" \"https://github.com/MikeWuPing/gsetupmod/releases/download/v$version/gsetupmod-manual-brief.docx\" \"$dir\\gsetupmod-manual-brief.docx\"",
        "Invoke-CachedDownload $app ${version}\"_manual-detailed\" \"https://github.com/MikeWuPing/gsetupmod/releases/download/v$version/gsetupmod-manual-detailed.docx\" \"$dir\\gsetupmod-manual-detailed.docx\"",
        "Invoke-CachedDownload $app ${version}\"_efi\" \"https://github.com/MikeWuPing/gsetupmod/releases/download/v$version/gsetupmod.efi\" \"$dir\\gsetupmod.efi\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/MikeWuPing/gsetupmod/releases",
        "regex": "(?sm)browser_download_url.*?releases/download/v([\\d.]+)/(?<file>gsetupmod-boot-([\\d.]+).iso)"
    },
    "autoupdate": {
        "url": "https://github.com/MikeWuPing/gsetupmod/releases/download/v$version/gsetupmod-boot-$version.iso#dl.iso_",
        "hash": {
            "url": "https://api.github.com/repos/MikeWuPing/gsetupmod/releases",
            "regex": "(?s)$basename[\\s\\S]*?\"digest\"\\s*:\\s*\"([^\"]+)\""
        }
    }
}
