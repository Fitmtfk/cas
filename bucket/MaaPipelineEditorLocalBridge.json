{
    "version": "1.9.3",
    "license": "MIT",
    "homepage": "https://github.com/kqcoxn/MaaPipelineEditor",
    "depends": "MaaFramework",
    "url": "https://github.com/kqcoxn/MaaPipelineEditor/releases/download/v1.9.3/mpelb-windows-amd64.exe",
    "hash": "5e9128ba11e669cd2962b924a754c08a15d76cfc6381c479faec4982bd847a2f",
    "pre_install": "Rename-Item \"$dir\\mpelb-windows-amd64.exe\" \"mpelb.exe\" -Force",
    "post_install": [
        "Write-Host `n\"Init runtime.\"",
        "if (!(Test-Path \"$persist_dir\\runtime\\resource\\model\\ocr\")) {",
        "   $dlFile = 'dl.zip'",
        "   Invoke-CachedDownload $app ${version}\"_ocr\" \"https://download.maafw.xyz/MaaCommonAssets/OCR/ppocr_v6/ppocr_v6-small.zip\" \"$dir\\$dlFile\"",
        "   Expand-7zipArchive \"$dir\\$dlfile\" \"$dir\\runtime\\resource\\model\\ocr\" -Removal",
        "}",
        "if (!(Test-Path \"$persist_dir\\runtime\\maafw\")) {",
        "   New-Item -ItemType Junction -Path \"$persist_dir\\runtime\\maafw\" -Value \"$(appdir MaaFramework $global)\\current\"",
        "}",
        "Write-Host \"Finish.\""
    ],
    "persist": "runtime",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/kqcoxn/MaaPipelineEditor/releases/download/v$version/mpelb-windows-amd64.exe"
    },
    "bin": "mpelb.exe"
}
