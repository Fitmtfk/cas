{
    "version": "7.25.6",
    "description": "A V2Ray client for Windows, support Xray & v2fly core",
    "homepage": "https://github.com/2dust/v2rayN",
    "license": "GPL-3.0-only",
    "suggest": {
        ".NET Desktop Runtime": "extras/windowsdesktop-runtime-lts",
        "v2fly-core": "v2ray"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/2dust/v2rayN/releases/download/7.25.6/v2rayN-windows-64.zip",
            "hash": "9b94718c2a214a246b04dec84b9a27f1f0ced8489c2dd25eb80a0fbb806bd13f",
            "extract_dir": "v2rayN-windows-64"
        },
        "arm64": {
            "url": "https://github.com/2dust/v2rayN/releases/download/7.25.6/v2rayN-windows-arm64.zip",
            "hash": "4f01badc9bb3a1fd805104192d54f06d69b0d122ffbff884f521242619ad42f3",
            "extract_dir": "v2rayN-windows-arm64"
        }
    },
    "pre_install": [
        "Copy-Item -Path \"$dir\\bin\" -Destination \"$persist_dir\" -Recurse -Force",
        "Remove-Item -Path \"$dir\\bin\" -Recurse -Force"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'cas' }",
        ". $bucketsdir\\$bucket\\script\\utils.ps1",
        "Update-ScoopTrayIconPath -AppName 'v2rayn' -NewVersion $version -RestartExplorer"
    ],
    "shortcuts": [
        [
            "v2rayN.exe",
            "v2rayN"
        ]
    ],
    "persist": [
        "guiConfigs",
        "bin"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/2dust/v2rayN/releases/download/$version/v2rayN-windows-64.zip",
                "hash": {
                    "mode": "github"
                }
            },
            "arm64": {
                "url": "https://github.com/2dust/v2rayN/releases/download/$version/v2rayN-windows-arm64.zip",
                "hash": {
                    "mode": "github"
                }
            }
        }
    }
}
